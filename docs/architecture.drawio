55" value="" style="line;html=1;strokeWidth=1;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1230" y="410" width="280" height="10" as="geometry"/></mxCell><mxCell id="n56" value="&lt;div style=&quot;margin-bottom:8px;&quot;&gt;&lt;b&gt;Module :&lt;/b&gt; &lt;font face=&quot;Consolas, Courier New, monospace&quot;&gt;src/model.py&lt;/font&gt;, &lt;font face=&quot;Consolas, Courier New, monospace&quot;&gt;train_model()&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;margin-bottom:8px;&quot;&gt;&lt;b&gt;Type d&#x27;objet :&lt;/b&gt; &lt;font face=&quot;Consolas, Courier New, monospace&quot;&gt;RandomForestClassifier&lt;/font&gt; en mémoire, pas sauvegardé sur disque&lt;/div&gt;&lt;div&gt;&lt;b&gt;Préparation :&lt;/b&gt;&lt;/div&gt;&lt;ul style=&quot;margin:2px 0 8px 0;padding-left:18px;&quot;&gt;&lt;li&gt;Cible et téléphone valant Yes ou No : 23 482 lignes gardées&lt;/li&gt;&lt;li&gt;&lt;font face=&quot;Consolas, Courier New, monospace&quot;&gt;uniqueid&lt;/font&gt; exclu des variables&lt;/li&gt;&lt;li&gt;Yes / No → 1 / 0&lt;/li&gt;&lt;li&gt;One-hot encoding (&lt;font face=&quot;Consolas, Courier New, monospace&quot;&gt;pd.get_dummies&lt;/font&gt;) : 47 variables&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;b&gt;Modèle :&lt;/b&gt;&lt;/div&gt;&lt;ul style=&quot;margin:2px 0 8px 0;padding-left:18px;&quot;&gt;&lt;li&gt;Random Forest, 200 arbres&lt;/li&gt;&lt;li&gt;&lt;font face=&quot;Consolas, Courier New, monospace&quot;&gt;random_state = 42&lt;/font&gt;&lt;/li&gt;&lt;li&gt;Entraîné sur toutes les lignes gardées&lt;/li&gt;&lt;/ul&gt;&lt;div style=&quot;margin-bottom:8px;&quot;&gt;&lt;b&gt;Cache :&lt;/b&gt; &lt;font face=&quot;Consolas, Courier New, monospace&quot;&gt;st.cache_resource&lt;/font&gt;, un entraînement par démarrage&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;spacing=0;" vertex="1" parent="1"><mxGeometry x="1205" y="432" width="335" height="315" as="geometry"/></mxCell><mxCell id="n57" value="" style="shape=singleArr